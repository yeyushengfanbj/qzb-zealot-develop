#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker-compose.local.yml"
ENV_FILE="$ROOT_DIR/.env"
ENV_LOCAL_FILE="$ROOT_DIR/.env.local"
STATE_FILE="$ROOT_DIR/.release-last-image"

usage() {
  cat <<'EOF'
Usage:
  bin/release-deploy <sha12|sha-tag|tag>

Examples:
  bin/release-deploy 4d8c98ee8097
  bin/release-deploy sha-4d8c98ee8097
  bin/release-deploy latest
EOF
}

if [[ $# -ne 1 ]]; then
  usage
  exit 1
fi

TARGET_RAW="$1"

current_image="$(grep -m1 '^ZEALOT_IMAGE=' "$ENV_FILE" | cut -d= -f2-)"
if [[ -z "${current_image}" ]]; then
  echo "ZEALOT_IMAGE not found in $ENV_FILE"
  exit 1
fi

repo="${current_image%:*}"
target_tag="$TARGET_RAW"

if [[ "$target_tag" =~ ^[0-9a-f]{7,40}$ ]]; then
  target_tag="sha-$target_tag"
fi

target_image="${repo}:${target_tag}"

echo "Checking image: $target_image"
docker manifest inspect "$target_image" >/dev/null

echo "$current_image" > "$STATE_FILE"
echo "Saved rollback image to $STATE_FILE"

replace_image_line() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    return
  fi

  if grep -q '^ZEALOT_IMAGE=' "$file"; then
    sed -i.bak "s|^ZEALOT_IMAGE=.*$|ZEALOT_IMAGE=$target_image|" "$file"
    rm -f "${file}.bak"
  else
    echo "ZEALOT_IMAGE=$target_image" >> "$file"
  fi
}

replace_image_line "$ENV_FILE"
replace_image_line "$ENV_LOCAL_FILE"

echo "Pulling and recreating service..."
docker compose -f "$COMPOSE_FILE" pull zealot
docker compose -f "$COMPOSE_FILE" up -d --force-recreate zealot

echo "Waiting for health check..."
ok=0
for _ in $(seq 1 30); do
  if curl -fsS --max-time 5 "http://localhost:8080/api/health" >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 2
done

if [[ "$ok" -ne 1 ]]; then
  echo "Health check failed. You can rollback with:"
  echo "  bin/release-rollback"
  exit 1
fi

echo "Deploy success: $target_image"
echo "Rollback command: bin/release-rollback"
