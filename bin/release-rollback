#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_FILE="$ROOT_DIR/docker-compose.local.yml"
ENV_FILE="$ROOT_DIR/.env"
ENV_LOCAL_FILE="$ROOT_DIR/.env.local"
STATE_FILE="$ROOT_DIR/.release-last-image"

usage() {
  cat <<'EOF'
Usage:
  bin/release-rollback [full-image]

Examples:
  bin/release-rollback
  bin/release-rollback ghcr.io/yeyushengfanbj/qzb-zealot-develop:sha-a4cddbc63fa6
EOF
}

if [[ $# -gt 1 ]]; then
  usage
  exit 1
fi

if [[ $# -eq 1 ]]; then
  rollback_image="$1"
else
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "No rollback state found at $STATE_FILE"
    echo "Provide a full image manually:"
    echo "  bin/release-rollback ghcr.io/<owner>/<repo>:<tag>"
    exit 1
  fi
  rollback_image="$(cat "$STATE_FILE")"
fi

echo "Rolling back to: $rollback_image"
docker manifest inspect "$rollback_image" >/dev/null

replace_image_line() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    return
  fi

  if grep -q '^ZEALOT_IMAGE=' "$file"; then
    sed -i.bak "s|^ZEALOT_IMAGE=.*$|ZEALOT_IMAGE=$rollback_image|" "$file"
    rm -f "${file}.bak"
  else
    echo "ZEALOT_IMAGE=$rollback_image" >> "$file"
  fi
}

replace_image_line "$ENV_FILE"
replace_image_line "$ENV_LOCAL_FILE"

docker compose -f "$COMPOSE_FILE" pull zealot
docker compose -f "$COMPOSE_FILE" up -d --force-recreate zealot

ok=0
for _ in $(seq 1 30); do
  if curl -fsS --max-time 5 "http://localhost:8080/api/health" >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 2
done

if [[ "$ok" -ne 1 ]]; then
  echo "Rollback completed, but health check is not ready yet."
  exit 1
fi

echo "Rollback success: $rollback_image"
